<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../../mods/nuget.config</RestoreConfigFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../mods/GoomeMod/*.cs" />
    <ProjectReference Include="../../src/GoomeSharp/GoomeSharp.csproj" />
    <PackageReference Include="HarmonyX" Version="2.16.1" />
  </ItemGroup>

</Project>
